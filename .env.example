# ============================================================================
# ESENCIA TÉCNICA · E-COMMERCE
# Copiá este archivo a `.env.local` y completá los valores.
# NUNCA subas `.env.local` al repositorio.
# ============================================================================

# --- SUPABASE · PROYECTO E-COMMERCE / QUÍMICA -------------------------------
# Este proyecto contiene productos, pedidos, stock, comprobantes y verificaciones.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO-ECOMM.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_del_proyecto_ecomm
# Solo se usa en API Routes / Server Actions. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_del_proyecto_ecomm

# --- RESEND · CORREOS TRANSACCIONALES DEL ECOMM -----------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Esencia Técnica <ventas@nexobow.site>

# --- PANEL ADMINISTRADOR (/admin, Basic Auth) -------------------------------
ADMIN_PASSWORD=una_clave_larga_y_unica

# --- CRON DE VENCIDOS (Vercel, viernes 23:59 ART) ---------------------------
# Protege /api/cron/vencidos. Vercel lo manda como Authorization: Bearer <CRON_SECRET>.
# Sin esta variable el endpoint responde 503; con un secreto incorrecto, 401.
CRON_SECRET=un_secreto_largo_y_unico

# --- TRANSFERENCIA (checkout, gate G4) ---------------------------------------
# Los confirma la Cooperadora. Están los tres o no se muestran: el sistema no
# inventa datos bancarios (docs/specs/front-mvp/spec.md §6.1).
NEXT_PUBLIC_TRANSFERENCIA_ALIAS=
NEXT_PUBLIC_TRANSFERENCIA_CBU=
NEXT_PUBLIC_TRANSFERENCIA_TITULAR=

# --- GOOGLE SHEETS (opcional) -----------------------------------------------
SHEETS_WEBHOOK_URL=

# --- PUENTE TEMPORAL CON TEAMS ----------------------------------------------
# Solo si se conserva `/api/notifications` en este repo (decisión actual).
# Lo ideal es mover ese endpoint al repo quimicashop y borrar estas variables.
TEAMS_SUPABASE_URL=https://TU-PROYECTO-TEAMS.supabase.co
TEAMS_SUPABASE_ANON_KEY=tu_anon_key_del_proyecto_teams
# URL pública del Hub/Teams para los botones de los emails.
TEAMS_HUB_URL=https://juanmamerodio.github.io/quimicashop/tasks.html
# Remitente de los correos de Teams (opcional).
RESEND_FROM=QuimicaShop Teams <notificaciones@nexobow.site>
